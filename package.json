{
  "name": "zgu-model",
  "version": "1.24.4",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "installer:art": "node scripts/gen-installer-art.mjs",
    "desktop:export": "node scripts/desktop-export.mjs",
    "desktop:start": "electron electron-main.js",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --win --x64",
    "desktop:publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.2",
    "@react-three/postprocessing": "^2.19.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.2.1",
    "framer-motion": "^11.1.7",
    "framer-motion-3d": "^12.4.13",
    "lucide-react": "^1.14.0",
    "motion": "^11.1.7",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "^10.4.1",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.164.0",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.zgu.model.editor",
    "productName": "ZGU-Model-3D",
    "copyright": "Copyright © 2026 ZGU",
    "directories": {
      "output": "desktop/output",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GohaCraft",
        "repo": "ptk-projectxc"
      }
    ],
    "files": [
      "electron-main.js",
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "artifactName": "ZGU-3D-Model-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "ЗГУ",
      "shortcutName": "ЗГУ 3D Модель",
      "uninstallDisplayName": "ЗГУ 3D Модель ${version}",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "language": "1049",
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "installerHeaderIcon": "public/favicon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    }
  }
}
